MESHY_API_KEY=replace_with_your_meshy_api_key
# Provided by the connected Neon database on Vercel. DATABASE_URL is the pooled connection.
DATABASE_URL=replace_with_the_neon_pooled_connection_string
DATABASE_URL_UNPOOLED=replace_with_the_neon_direct_connection_string
MESHY_BLOB_STORE_ID=replace_with_your_public_blob_store_id
MESHY_BLOB_READ_WRITE_TOKEN=replace_with_your_public_blob_store_token
BLOB_UPLOAD_SECRET=replace_with_a_long_random_secret
CRON_SECRET=replace_with_a_long_random_secret
